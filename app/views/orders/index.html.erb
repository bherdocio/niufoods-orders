<% content_for :head do %>
  <meta http-equiv="refresh" content="30">
<% end %>

<h1>Órdenes</h1>

<%= form_with url: orders_path, method: :get, class: "filters" do %>
  <%= label_tag :from, "Desde", class: "filter-label" %>
  <%= date_field_tag :from, @filter.from %>
  <%= label_tag :to, "Hasta", class: "filter-label" %>
  <%= date_field_tag :to, @filter.to %>
  <%= select_tag :restaurant_id,
        options_from_collection_for_select(@restaurants, :id, :name, @filter.restaurant_id),
        include_blank: "Todas las tiendas" %>
  <%= select_tag :status,
        options_for_select(Order.dispatch_statuses.keys.map { |s| [ dispatch_status_label(s), s ] }, @filter.status),
        include_blank: "Todos los estados" %>
  <%= submit_tag "Filtrar", name: nil %>
  <%= link_to "Limpiar", orders_path %>
<% end %>

<p class="period"><%= period_description(@filter) %></p>

<div class="stats">
  <% Order.dispatch_statuses.each_key do |status| %>
    <%= link_to orders_path(request.query_parameters.except("page").merge("status" => status)), class: "stat stat-#{status}" do %>
      <span class="stat-value"><%= @status_counts.fetch(status, 0) %></span>
      <span class="stat-label"><%= dispatch_status_label(status) %></span>
    <% end %>
  <% end %>
  <div class="stat stat-kpi">
    <span class="stat-value"><%= clp(@stats.total_sales) %></span>
    <span class="stat-label">Ventas totales</span>
  </div>
  <div class="stat stat-kpi">
    <span class="stat-value"><%= clp(@stats.average_ticket) %></span>
    <span class="stat-label">Ticket promedio</span>
  </div>
</div>

<section class="card">
  <h2>Ventas en el tiempo</h2>
  <%= render "column_chart", rows: @stats.sales_over_time %>
  <p class="chart-note">Por hora si el período abarca hasta 24 horas; por día si es mayor. Pasa el cursor sobre una barra para ver el monto.</p>
</section>

<div class="charts">
  <section class="card">
    <h2>Ventas por tienda</h2>
    <%= render "bar_chart", rows: restaurant_chart_rows(@stats) %>
  </section>
  <section class="card">
    <h2>Productos más vendidos</h2>
    <%= render "bar_chart", rows: product_chart_rows(@stats) %>
  </section>
</div>

<section class="card">
  <% if @orders.any? %>
    <table>
      <thead>
        <tr>
          <th>N°</th>
          <th>Tienda</th>
          <th>Tipo</th>
          <th class="num">Total</th>
          <th>Creada</th>
          <th>Despacho</th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td><%= link_to "##{order.id}", order_path(order) %></td>
            <td><%= order.restaurant.name %></td>
            <td><%= order_type_label(order) %></td>
            <td class="num"><%= clp(order.total_amount) %></td>
            <td><%= format_time(order.created_at) %></td>
            <td><%= dispatch_status_badge(order) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty">No hay órdenes para estos filtros.</p>
  <% end %>
</section>

<nav class="pagination">
  <span>
    <% if @page > 1 %>
      <%= link_to "← Anterior", orders_path(request.query_parameters.merge("page" => @page - 1)) %>
    <% end %>
  </span>
  <span>Página <%= @page %></span>
  <span>
    <% if @next_page %>
      <%= link_to "Siguiente →", orders_path(request.query_parameters.merge("page" => @page + 1)) %>
    <% end %>
  </span>
</nav>