<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Niu Foods · Órdenes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <header class="topbar">
      <%= link_to root_path, class: "brand" do %>
        <span class="brand-dot"></span>
        <span class="brand-name">Niu Foods</span>
        <span class="brand-sub">Centro de órdenes</span>
      <% end %>
    </header>
    <main class="container">
      <% if notice %><p class="flash flash-notice"><%= notice %></p><% end %>
      <% if alert %><p class="flash flash-alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>